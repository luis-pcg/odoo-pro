meta {
  name: 06 - ACECF aprobar comercialmente
  type: http
  seq: 6
}

post {
  url: {{base_url}}/acecf/?submit_to_dgii=true
  body: json
  auth: none
}

params:query {
  submit_to_dgii: true
}

headers {
  x-api-key: {{api_key}}
  env: {{dgii_env}}
  Content-Type: application/json
}

body:json {
  {
    "issuer_rnc": "{{issuer_rnc}}",
    "receiver_rnc": "{{buyer_rnc}}",
    "encf": "{{encf}}",
    "dgii_environment": "{{dgii_env}}",
    "approval_status": 1,
    "approval_datetime": "2026-08-12T14:30:00",
    "invoice_date_issued": "2020-04-01",
    "invoice_total_amount": 25000000.00
  }
}

docs {
  approval_status 1 = aprobado comercialmente.

  TRAMPAS
  - El body usa ISO-8601 (los headers del listado usan DD-MM-YYYY).
  - NO enviar xml_gcs_path ni xml_checksum: los genera el servicio y mandarlos
    es lo que hace fallar la llamada.
}
