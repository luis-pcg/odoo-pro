{
   "version": "0.2.0",
   "configurations": [
       {
           "name": "Python: Remote Attach",
           "type": "debugpy",
           "request": "attach",
           "connect": {
               "host": "localhost",
               "port": 8091
           },
           "pathMappings": [
               {
                   "localRoot": "${workspaceFolder}/addons",
                   "remoteRoot": "/mnt/extra-addons"
               },
               {
                   "localRoot": "${workspaceFolder}/pyazul/pyazul",
                   "remoteRoot": "/usr/local/lib/python3.12/dist-packages/pyazul"
               }
           ],
           "justMyCode": false
       }
   ]
}
